@model List<TsdLab06.Models.Product>

<div class="hot-product">

    <div class="hot-title">
        Sản phẩm nổi bật
    </div>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="product">

                    <img src="@item.Image"
                         alt="@item.Name"
                         class="img-fluid" />

                    <h5>
                        @item.Name
                    </h5>

                    <p>
                        Giá: @item.Price.ToString("N0") VNĐ
                    </p>

                </div>

            </div>
        }

    </div>

</div>