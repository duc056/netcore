@model TsdNetCoreLab6_EF.Models.TsdCategory

@{
    ViewData["Title"] = "Xóa danh mục";
}

<h2>Xóa danh mục</h2>

<h4>Bạn có chắc muốn xóa danh mục này không?</h4>

<hr />

<div>

    <dl class="row">

        <dt class="col-sm-3">
            Tên danh mục
        </dt>

        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Name)
        </dd>


        <dt class="col-sm-3">
            Trạng thái
        </dt>

        <dd class="col-sm-9">

            @if (Model.Status == 1)
            {
                <span class="text-success">
                    Hiển thị
                </span>
            }
            else
            {
                <span class="text-danger">
                    Khóa
                </span>
            }

        </dd>


        <dt class="col-sm-3">
            Ngày tạo
        </dt>

        <dd class="col-sm-9">
            @Html.DisplayFor(
                model => model.CreatedDate
            )
        </dd>

    </dl>

    <form asp-action="TsdDeleteConfirmed"
          method="post">

        <input type="hidden"
               name="tsdId"
               value="@Model.Id" />

        <input type="submit"
               value="Xóa"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Hủy
        </a>

    </form>

</div>