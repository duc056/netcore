@model Tsd2410900028_exam.Models.TsdStudent

@{
    ViewData["Title"] = "Create";
}

<h1 class="text-center mb-4">THÊM SINH VIÊN</h1>

<h4>TsdStudent</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="TsdName" class="control-label">Họ và tên</label>
                <input asp-for="TsdName" class="form-control" placeholder="Nhập họ và tên" />
                <span asp-validation-for="TsdName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TsdGender" class="control-label">Giới tính</label>
                <select asp-for="TsdGender" class="form-select">
                    <option value="true">Nam</option>
                    <option value="false">Nữ</option>
                </select>
                <span asp-validation-for="TsdGender" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TsdBirthDay" class="control-label">Ngày sinh</label>
                <input asp-for="TsdBirthDay" class="form-control" type="date" />
                <span asp-validation-for="TsdBirthDay" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TsdEmail" class="control-label">Email</label>
                <input asp-for="TsdEmail" class="form-control" placeholder="Nhập email" />
                <span asp-validation-for="TsdEmail" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TsdPhone" class="control-label">Số điện thoại</label>
                <input asp-for="TsdPhone" class="form-control" placeholder="Nhập số điện thoại" />
                <span asp-validation-for="TsdPhone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TsdActive" class="control-label">Trạng thái</label>
                <select asp-for="TsdActive" class="form-select">
                    <option value="true">Hoạt động</option>
                    <option value="false">Không hoạt động</option>
                </select>
                <span asp-validation-for="TsdActive" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Thêm sinh viên" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>