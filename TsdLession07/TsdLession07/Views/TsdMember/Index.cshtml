@model IEnumerable<TsdLession07.Models.DataModels.TsdMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card p-3">
    <h1>@ViewData["Title"]</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary my-1">Thêm mới</a>
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.TsdMemberId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TsdUserName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TsdPassword)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TsdFullName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TsdEmail)
                </th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.TsdMemberId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TsdUserName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TsdPassword)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TsdFullName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TsdEmail)
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                        @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                        @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>